						"body": {
							"mode": "raw",
							"raw": "{\n  \"providerId\": \"prov-a\",\n  \"externalTransactionId\": \"tx-test-001\",\n  \"playerId\": \"player-test\",\n  \"walletId\": \"test-wallet-001\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"slots-1\",\n  \"kind\": \"BET\",\n  \"amount\": \"10.00\",\n  \"currency\": \"BRL\"\n}",
							"options": {
