						}
					}
				},
				{
					"name": "Get Ledger",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/wallets/test-wallet-001/ledger?limit=50",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["wallets", "test-wallet-001", "ledger"],
							"query": [
								{
									"key": "limit",
									"value": "50"
